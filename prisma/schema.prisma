generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AdminAuditLog[]
}

model Registration {
  id                String            @id @default(cuid())
  rollNumber        String            @unique
  leaderName        String
  ambassadorId      String?           @map("ambassador_id")
  leaderEmail       String
  leaderPhone       String
  city              String
  institution       String
  participationType String
  teamSize          Int
  trackName         String
  projectIdea       String            @db.Text
  status            ApplicationStatus @default(PENDING)
  rejectionReason   String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           TeamMember[]
  paymentProof      PaymentProof?

  @@index([leaderEmail])
  @@index([status])
  @@index([trackName])
  @@index([city])
  @@index([createdAt])
}

model TeamMember {
  id             String       @id @default(cuid())
  registrationId String
  fullName       String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model PaymentProof {
  id             String        @id @default(cuid())
  registrationId String        @unique
  storageKey     String
  originalName   String
  mimeType       String
  fileSize       Int
  fileData       Bytes         @db.MediumBlob
  status         PaymentStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model Track {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  speaker     String?
  dateLabel   String?
  timeLabel   String?
  imageKey    String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SponsorApplication {
  id                  String       @id @default(cuid())
  fullName            String
  email               String
  phone               String
  designation         String
  organization        String
  website             String?
  preferredTier       String
  contributionTypes   Json
  estimatedValue      Decimal?     @db.Decimal(12, 2)
  message             String?      @db.Text
  logoStorageKey      String?
  status              ReviewStatus @default(PENDING_REVIEW)
  isPublished         Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SpeakerApplication {
  id                String       @id @default(cuid())
  fullName          String
  email             String
  phone             String
  whatsapp          String
  linkedin          String?
  organization      String
  jobTitle          String
  expertise         String
  yearsExperience   Int
  sessionTitle      String
  sessionDescription String     @db.Text
  profilePhotoKey   String?
  status            ReviewStatus @default(PENDING_REVIEW)
  isPublished       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([isPublished])
}

model FAQ {
  id         String   @id @default(cuid())
  question   String
  answer     String   @db.Text
  isPublished Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TimelineEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  dateLabel   String?
  startsAt    DateTime?
  endsAt      DateTime?
  statusLabel String   @default("To be announced")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
}
model RollNumberCounter {
  id         String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ContactInquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}